# monday.com personal API token (read-only use). Server only.
MONDAY_API_TOKEN=

# Supabase project URL and service-role key. Server only; never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for /api/sync. Callers send "Authorization: Bearer <SYNC_SECRET>".
# Generate with: openssl rand -hex 32
SYNC_SECRET=
