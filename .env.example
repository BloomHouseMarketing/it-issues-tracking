# monday.com personal API token (read-only use). Server only.
MONDAY_API_TOKEN=

# Supabase project URL and service-role key. Server only; never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for /api/sync. Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" automatically.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Shared password for the dashboard login page. Server only.
DASHBOARD_PASSWORD=
