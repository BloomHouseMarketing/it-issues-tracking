{
  "name": "coastal-it-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "sync": "node --env-file-if-exists=.env.local --import tsx scripts/sync.ts",
    "counts": "node --env-file-if-exists=.env.local --import tsx scripts/verify-counts.ts",
    "check:metrics": "node --env-file-if-exists=.env.local --import tsx scripts/check-metrics.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
